        "selector": "#inner-password",
        "delayBeforeInsertMs": 1800
      },
      "value": "basic",
      "expect": {
        "outcome": "error",
        "reason": "target-changed",
        "receipt": null
      }
    },
    {
      "id": "ambiguous-before-insert",
      "open": [
        {
          "ref": "main",
          "origin": "A",
          "page": "ambiguous.html",
