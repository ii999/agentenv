{
  "version": 1,
  "description": "Parity scenarios for the CDP filling clients. {A} and {B} are replaced with the fixture origins (127.0.0.1 and localhost). Each scenario is run once per implementation against freshly opened pages, with receipts cleared first.",
  "values": {
    "basic": "correct horse battery staple",
    "unicode": "pässwörd-日本語-🔑-\"quoted\"-<b>&amp;</b>-\\slash-'single'-`tick`-{json}",
    "spaces": "  leading and trailing  ",
    "long": "ghp_"
  },
  "reasons": [
    "connect-failed",
    "version-unsupported",
    "context-absent",
    "page-absent",
    "page-ambiguous",
    "frame-absent",
    "frame-ambiguous",
    "frame-invalid",
    "target-absent",
    "target-ambiguous",
    "target-hidden",
    "target-disabled",
    "target-readonly",
    "target-unfillable",
    "target-changed",
    "timeout",
    "recording-conflict"
  ],
  "filledEvents": [
    "focus",
    "beforeinput",
    "input"
  ],
  "scenarios": [
    {
      "id": "text-basic",
      "open": [
        {
          "ref": "main",
          "origin": "A",
          "page": "login.html",
          "context": 0
        }
      ],
      "request": {
        "pageUrl": "{A}/pages/login.html",
        "selector": "#username"
      },
      "value": "basic",
      "expect": {
        "outcome": "filled",
        "receipt": {
          "ref": "main",
          "frame": "main",
          "field": "username",
          "value": "basic"
        }
      }
    },
    {
