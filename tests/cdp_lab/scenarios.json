        "contextIndex": 3,
        "selector": "#username"
      },
      "value": "basic",
      "expect": {
        "outcome": "error",
        "reason": "context-absent",
        "receipt": null
      }
    },
    {
      "id": "navigation-before-insert",
      "open": [
        {
          "ref": "main",
          "origin": "A",
          "page": "navigate.html",
