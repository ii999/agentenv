      "expect": {
        "outcome": "error",
        "reason": "target-ambiguous",
        "receipt": null
      },
      "notes": "Revalidation must count matches again, not merely check that the prepared element is still attached."
    },
    {
      "id": "timeout-before-insert",
      "open": [
        {
          "ref": "main",
          "origin": "A",
          "page": "login.html",
          "context": 0
        }
