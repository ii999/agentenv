          "context": 0
        }
      ],
      "request": {
        "pageUrl": "{A}/pages/navigate.html?after=800",
        "selector": "#password",
        "delayBeforeInsertMs": 1800
      },
      "value": "basic",
      "expect": {
        "outcome": "error",
        "reason": "target-changed",
        "receipt": null
      },
      "notes": "The page navigates to a document with the same selector during the delay; a retargeting client would fill the new field and produce a receipt."
    },
    {
      "id": "frame-detached-before-insert",
      "open": [
        {
          "ref": "main",
          "origin": "A",
          "page": "detach.html",
