#!/usr/bin/env python3
import os
import signal
import sys
import time

pid_path = sys.argv[1]
detached = len(sys.argv) > 2 and sys.argv[2] == "detached"

if detached:
    child = os.fork()
    if child == 0:
        os.setsid()
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        with open(pid_path, "w", encoding="ascii") as handle:
            handle.write(str(os.getpid()))
        time.sleep(30)
        raise SystemExit(0)
    os.waitpid(child, 0)
else:
    with open(pid_path, "w", encoding="ascii") as handle:
        handle.write(str(os.getpid()))
    time.sleep(30)
